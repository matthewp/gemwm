---
import { render } from 'astro:content';
import Manual from '../../layouts/Manual.astro';
import { docs, docSections, docHref } from '../../lib/nav';

export async function getStaticPaths() {
	const all = await docs();
	return all.map((entry, i) => ({
		params: { id: entry.id },
		props: { entry, prev: all[i - 1], next: all[i + 1] },
	}));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const sections = await docSections();
const groups = sections.map(({ section, pages }) => ({
	name: section,
	items: pages.map((d) => ({ label: d.data.short ?? d.data.title, href: docHref(d) })),
}));
---
<Manual
	title={entry.data.title}
	description={entry.data.description}
	window={`Docs \\ ${entry.data.section} \\ ${entry.data.short ?? entry.data.title}`}
	close="/docs/"
	groups={groups}
>
	<h1>{entry.data.title}</h1>
	<Content />
	<nav class="buttons pager" aria-label="More docs">
		{prev && <a class="button" href={docHref(prev)}>&lt; {prev.data.short ?? prev.data.title}</a>}
		{next && <a class="button default" href={docHref(next)}>{next.data.short ?? next.data.title} &gt;</a>}
	</nav>
</Manual>

<style>
	.pager {
		justify-content: space-between;
		margin-top: 48px;
	}

	.pager .default:only-child {
		margin-left: auto;
	}
</style>
