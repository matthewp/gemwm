#!/bin/sh
# Starts GemWM as a login session (see gemwm.desktop).
#
# Settings such as GEMWM_DESKTOP, GEMWM_FONT or XKB_DEFAULT_LAYOUT can go
# in ~/.config/gemwm/env, which is sourced as a shell script.

export XDG_CURRENT_DESKTOP=GemWM
export XDG_SESSION_DESKTOP=gemwm
export XDG_SESSION_TYPE=wayland

config="${XDG_CONFIG_HOME:-$HOME/.config}/gemwm"
[ -f "$config/env" ] && . "$config/env"

log_dir="${XDG_STATE_HOME:-$HOME/.local/state}"
mkdir -p "$log_dir"
[ -f "$log_dir/gemwm.log" ] && mv "$log_dir/gemwm.log" "$log_dir/gemwm.log.old"

# AI (Augur, the service programs ask for it) is off with [ai] enabled =
# false in GemWM's config: Augur reports itself off, and programs hide
# their AI features. Set either way, so a session after one with it off
# has it on again.
AUGUR_DISABLED=$(awk '
	/^[ \t]*\[/ { section = $0; gsub(/[][ \t]/, "", section); next }
	section == "ai" && /^[ \t]*enabled[ \t]*=/ {
		value = $0; sub(/^[^=]*=[ \t]*/, "", value); sub(/[ \t]*#.*/, "", value)
		off = value ~ /^(false|no|off|0)$/
	}
	END { print off ? "1" : "" }
' "$config/config" 2>/dev/null)
export AUGUR_DISABLED

# Tell D-Bus and systemd services (portals, notifications, Augur) where we
# are.
exec gemwm -s "dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP AUGUR_DISABLED" \
	> "$log_dir/gemwm.log" 2>&1
